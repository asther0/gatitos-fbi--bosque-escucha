{
  "name": "Bosque Escucha - Notificaciones Zavu",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "webhook",
      "name": "Solicitud aprobada",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "bosque-notificaciones",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "send",
      "name": "Despachar con reserva persistente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://bosque-escucha.vercel.app/api/notifications/zavu/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.body.notification.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { notification_id: $json.body.notification.id } }}",
        "options": {
          "timeout": 20000
        }
      }
    }
  ],
  "connections": {
    "Solicitud aprobada": {
      "main": [
        [
          {
            "node": "Despachar con reserva persistente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
